# API Service Container for Tenant Management
# This container provides REST API endpoints for managing tenant configurations
FROM registry.redhat.io/ubi9/ubi:latest

# Set FIPS crypto policies
RUN update-crypto-policies --set FIPS

# Configure AWS SDK to use FIPS endpoints
ENV AWS_USE_FIPS_ENDPOINT=true

# Verify FIPS mode is enabled
RUN test -f /proc/sys/crypto/fips_enabled && cat /proc/sys/crypto/fips_enabled | grep -q 1

# Install python and FIPS-validated packages from RHEL repositories
RUN dnf install -y python3 python3-cryptography python3-boto3 && dnf clean all

# Set working directory
WORKDIR /app

# Copy API source code
COPY src/ ./src/

# Copy project metadata (for reference, pip/uv are not used)
COPY pyproject.toml README.md ./

# Set the Lambda handler
CMD ["src.app.lambda_handler"]