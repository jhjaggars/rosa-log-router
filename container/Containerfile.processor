# FIPS Compliant Log Processor
FROM registry.redhat.io/ubi9/ubi:latest

# Set FIPS crypto policies
RUN update-crypto-policies --set FIPS

# Configure AWS SDK to use FIPS endpoints
ENV AWS_USE_FIPS_ENDPOINT=true

# Verify FIPS mode is enabled
RUN test -f /proc/sys/crypto/fips_enabled && cat /proc/sys/crypto/fips_enabled | grep -q 1

USER 0

# Install Python and FIPS-validated packages
RUN dnf install -y python3 python3-cryptography python3-boto3 python3-simplejson && \
    dnf clean all

# Create app directory
WORKDIR /app

# Copy application code
COPY log_processor.py .
COPY entrypoint.sh .
COPY vector_config_template.yaml .

# Make entrypoint executable
RUN chmod +x entrypoint.sh

# Create non-root user for security
RUN useradd -r -s /bin/false logprocessor
USER logprocessor

# Set entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]