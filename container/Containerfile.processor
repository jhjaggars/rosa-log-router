# FIPS Compliant Log Processor
FROM registry.redhat.io/ubi9/ubi:latest

# Set FIPS crypto policies
RUN update-crypto-policies --set FIPS

# Configure AWS SDK to use FIPS endpoints
ENV AWS_USE_FIPS_ENDPOINT=true

USER 0

# Install Python and available packages from dnf
RUN dnf install -y python3 python3-pip python3-cryptography && \
    dnf clean all

# Install additional Python packages via pip
RUN pip3 install --no-cache-dir boto3 simplejson

# Create app directory
WORKDIR /app

# Copy application code
COPY log_processor.py .
COPY entrypoint.sh .
COPY vector_config_template.yaml .

# Make entrypoint executable
RUN chmod +x entrypoint.sh

# Create non-root user for security
RUN useradd -r -s /bin/false logprocessor
USER logprocessor

# Set entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]